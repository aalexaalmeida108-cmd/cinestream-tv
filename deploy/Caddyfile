# Caddy - the front of the CineStream TV site in the cloud.
#
# The site itself is a pile of static files and is served straight off the
# disk. The gateway (the resolver) answers the manifests and the segments,
# and is proxied. One origin, one certificate, no CORS - the browser on the
# television never sees a cross-origin request.
#
# The domain has to point at this machine before Caddy can get the
# certificate. The A record of the domain is the public IP of the host.

{$TV_DOMAIN} {
	encode gzip zstd

	# The gateway first: the manifests and the segments.
	handle /tv/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /tsseg/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /seg/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /stream/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /check/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /cat/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /poster/* {
		reverse_proxy 127.0.0.1:8730
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8730
	}
	handle /site/* {
		reverse_proxy 127.0.0.1:8730
	}

	# Everything else is the site: the catalog, the covers, the player.
	handle {
		root * /opt/cinestream/site
		file_server
	}
}
